rules_version = '2';

// The backend uses the Firebase Admin SDK which bypasses these rules entirely.
// These rules govern what the browser client is allowed to do directly.
//
// In this architecture, the browser should not write to `diagnoses`.
// All writes go through the backend. The browser can read only its own data.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Single admin source: users/{uid}.role == "admin".
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Per-user diagnosis history. Only the owning user may read.
    // Writes are denied to the browser (backend writes via Admin SDK).
    match /diagnoses/{docId} {
      allow read: if isSignedIn()
                  && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // User profile docs.
    // Users can read/write only their own profile.
    // Role escalation is blocked: users cannot set role except the designated
    // bootstrap admin account on create.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && (
                      !('role' in request.resource.data)
                      || (
                        request.resource.data.role == "admin"
                        && request.auth.token.email == "bhmnader@gmail.com"
                      )
                    );
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).changedKeys().hasAny(["role"]);
      allow delete: if false;
    }

    // Appointments written directly from the browser (Appointments.jsx).
    // * create: only if new doc's patientUid matches caller
    // * read/update: only the owning patient and immutable patientUid
    // * delete: denied (soft-delete flow)
    match /appointments/{apptId} {
      allow create: if isSignedIn()
                    && request.resource.data.patientUid == request.auth.uid;
      allow read, update: if isSignedIn()
                          && resource.data.patientUid == request.auth.uid
                          && request.resource.data.patientUid == resource.data.patientUid;
      allow delete: if false;
    }

    // Incoming doctor requests from the doctors page.
    // Keep this signed-in only by project choice.
    match /doctorRequests/{requestId} {
      allow create: if isSignedIn()
                    && request.resource.data.status == "pending"
                    && request.resource.data.submittedByUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 1
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.specialty is string
                    && request.resource.data.specialty.size() > 1
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.lat >= -90
                    && request.resource.data.lat <= 90
                    && request.resource.data.lng >= -180
                    && request.resource.data.lng <= 180
                    && request.resource.data.locationLabel is string
                    && request.resource.data.locationLabel.size() > 0;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Doctors directory used in dashboard and appointments.
    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Default deny for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
