# ==== Server ====
PORT=3001

# ==== Gemini (AI symptom analysis) ====
# Get one from Google AI Studio / Gemini API
GEMINI_API_KEY=REPLACE_ME
# Optional: defaults to gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# ==== Groq (secondary AI fallback) ====
# Get one from https://console.groq.com/keys
GROQ_API_KEY=REPLACE_ME
# Optional: defaults to llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_FALLBACK_1=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_FALLBACK_2=qwen/qwen3-32b

# ==== Firebase Admin (server-side auth + Firestore) ====
# Preferred: JSON string for service account (single line).
FIREBASE_SERVICE_ACCOUNT=
# Alternative: absolute path to service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# Must match your Firebase project id.
FIREBASE_PROJECT_ID=
