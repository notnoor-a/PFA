# Copy this file to .env and fill in real values.
# Vite only exposes env vars that start with VITE_ to client-side code.

# ==== Backend ====
# Base URL of the Express backend that proxies to Gemini + Firebase.
# Change to your deployed URL in production.
VITE_API_URL=http://localhost:3001

# ==== EmailJS (appointment booking notifications) ====
# Sign up at https://www.emailjs.com/ to get these values.
# If left blank, booking will be blocked in the appointment form.
VITE_EMAILJS_SERVICE_ID=appointment
VITE_EMAILJS_TEMPLATE_ID=template_os2529s
VITE_EMAILJS_PUBLIC_KEY=JmgOmhYwVVX32qa96

# DO NOT put VITE_GEMINI_API_KEY here — the key now lives server-side only.
# Any `VITE_*` value is bundled into the browser and is effectively public.
