# Copy this file to .env and fill in real values.
# Vite only exposes env vars that start with VITE_ to client-side code.

# ==== Backend ====
# Base URL of the Express backend that proxies to Anthropic + Firebase.
# Change to your deployed URL in production.
VITE_API_URL=http://localhost:3001

# ==== EmailJS (appointment booking notifications) ====
# Sign up at https://www.emailjs.com/ to get these values.
# If left blank, booking will still save to Firestore but email will fail.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# DO NOT put VITE_ANTHROPIC_API_KEY here — the key now lives server-side only.
# Any `VITE_*` value is bundled into the browser and is effectively public.
