# ==== Server ====
PORT=3001

# ==== Gemini (AI symptom analysis) ====
# Get one from Google AI Studio / Gemini API
GEMINI_API_KEY=REPLACE_ME
# Optional: model override (defaults to gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# ==== Groq (secondary AI fallback) ====
# Get one from https://console.groq.com/keys
GROQ_API_KEY=REPLACE_ME
# Primary Groq model
# ==== Server ====
PORT=3001

# ==== Gemini (AI symptom analysis) ====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ==== Groq (secondary AI fallback) ====
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ==== Firebase Admin (server-side auth + Firestore) ====
FIREBASE_SERVICE_ACCOUNT=
# Your Firebase project id (must match the frontend config)
FIREBASE_PROJECT_ID=
