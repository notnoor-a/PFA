# ==== Server ====
PORT=3001

# ==== Anthropic (AI symptom analysis) ====
# Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ==== Firebase Admin (server-side auth + Firestore) ====
# Option A — path to your service-account JSON file (recommended for local dev):
#   1. Firebase Console → Project Settings → Service accounts → Generate new private key
#   2. Save the JSON file somewhere safe (DO NOT COMMIT IT)
#   3. Set this to its absolute path:
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Option B — paste the whole service-account JSON in one line (for prod / Docker):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Your Firebase project id (must match the frontend config)
FIREBASE_PROJECT_ID=pfa-project-3ec22
